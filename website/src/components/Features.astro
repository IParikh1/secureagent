---
// Features grid component
const features = [
  {
    icon: 'mcp',
    title: 'MCP Security',
    description: 'Scan Model Context Protocol configurations for tool injection, overprivileged access, and misconfigurations.',
    color: 'primary'
  },
  {
    icon: 'chain',
    title: 'LangChain Analysis',
    description: 'Detect vulnerabilities in LangChain agents, tools, and chains before deployment.',
    color: 'accent'
  },
  {
    icon: 'database',
    title: 'RAG Systems',
    description: 'Identify data leakage risks and prompt injection vectors in retrieval-augmented generation pipelines.',
    color: 'primary'
  },
  {
    icon: 'users',
    title: 'Multi-Agent',
    description: 'Analyze communication patterns and trust boundaries in multi-agent architectures.',
    color: 'accent'
  },
  {
    icon: 'cloud',
    title: 'Cloud Integration',
    description: 'Scan AWS, Azure, and GCP deployments for AI-specific security misconfigurations.',
    color: 'primary'
  },
  {
    icon: 'shield',
    title: 'Compliance',
    description: 'Generate compliance reports for SOC2, HIPAA, and emerging AI regulations.',
    color: 'accent'
  }
];

const icons: Record<string, string> = {
  mcp: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
  chain: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />`,
  database: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />`,
  users: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
  cloud: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />`,
  shield: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`
};
---

<section class="py-16 lg:py-24 px-6 lg:px-8 bg-dark-900/50" id="features">
  <div class="max-w-7xl mx-auto">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        Comprehensive Security for
        <span class="gradient-text">Every AI Stack</span>
      </h2>
      <p class="text-dark-300 text-lg">
        SecureAgent understands the unique security challenges of AI systems.
        Scan your entire stack with purpose-built analyzers.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {features.map((feature, index) => (
        <div
          class="card group hover:shadow-lg hover:shadow-primary-500/5 transition-all duration-300"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class={`w-12 h-12 rounded-lg flex items-center justify-center mb-4 ${
            feature.color === 'primary'
              ? 'bg-primary-500/10 text-primary-400'
              : 'bg-accent-500/10 text-accent-400'
          } group-hover:scale-110 transition-transform duration-300`}>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[feature.icon]} />
          </div>
          <h3 class="text-xl font-semibold mb-2 text-white">{feature.title}</h3>
          <p class="text-dark-300 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>

    <!-- Additional info -->
    <div class="mt-16 text-center">
      <p class="text-dark-400 mb-6">
        Built by security engineers who understand AI systems
      </p>
      <a
        href="https://github.com/ishanray/secureagent#readme"
        class="inline-flex items-center gap-2 text-primary-400 hover:text-primary-300 transition-colors"
      >
        <span>Read the documentation</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
