---
// Email capture component for waitlist
---

<section class="py-16 lg:py-24 px-6 lg:px-8" id="waitlist">
  <div class="max-w-4xl mx-auto">
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-dark-800 to-dark-900 border border-dark-700 p-8 lg:p-12">
      <!-- Background decoration -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-radial from-primary-500/10 to-transparent rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 bg-gradient-radial from-accent-500/10 to-transparent rounded-full blur-3xl"></div>

      <div class="relative z-10">
        <div class="text-center mb-8">
          <!-- Cloud badge -->
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/10 border border-primary-500/20 text-sm mb-6">
            <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
            </svg>
            <span class="text-primary-300">Coming Soon</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-bold mb-4">
            Get Early Access to
            <span class="gradient-text">SecureAgent Cloud</span>
          </h2>

          <p class="text-dark-300 text-lg max-w-2xl mx-auto">
            Continuous monitoring, team dashboards, and automated remediation.
            Join the waitlist for early access and exclusive updates.
          </p>
        </div>

        <!-- Email form -->
        <form
          class="max-w-lg mx-auto"
          action="https://formspree.io/f/placeholder"
          method="POST"
          id="waitlist-form"
        >
          <div class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1">
              <label for="email" class="sr-only">Email address</label>
              <input
                type="email"
                name="email"
                id="email"
                required
                placeholder="Enter your email"
                class="input-field w-full"
              />
            </div>
            <button type="submit" class="btn-primary whitespace-nowrap">
              <span id="btn-text">Join Waitlist</span>
              <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin ml-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>

          <!-- Success message -->
          <div id="success-message" class="hidden mt-4 p-4 rounded-lg bg-green-500/10 border border-green-500/20 text-green-400 text-center">
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            You're on the list! We'll be in touch soon.
          </div>

          <!-- Error message -->
          <div id="error-message" class="hidden mt-4 p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-center">
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Something went wrong. Please try again.
          </div>

          <p class="text-dark-500 text-sm text-center mt-4">
            No spam, ever. Unsubscribe anytime.
          </p>
        </form>

        <!-- Benefits list -->
        <div class="mt-10 grid sm:grid-cols-3 gap-4 text-center">
          <div class="p-4">
            <div class="text-primary-400 font-semibold mb-1">Early Access</div>
            <div class="text-dark-400 text-sm">Be first to try new features</div>
          </div>
          <div class="p-4">
            <div class="text-primary-400 font-semibold mb-1">Founder Pricing</div>
            <div class="text-dark-400 text-sm">Lock in discounted rates</div>
          </div>
          <div class="p-4">
            <div class="text-primary-400 font-semibold mb-1">Direct Access</div>
            <div class="text-dark-400 text-sm">Shape the product roadmap</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Show loading state
    if (btnText) btnText.textContent = 'Joining...';
    btnSpinner?.classList.remove('hidden');

    const formData = new FormData(form);
    const email = formData.get('email');

    try {
      // For demo purposes, simulate API call
      // In production, replace with actual form submission
      await new Promise(resolve => setTimeout(resolve, 1000));

      // Store email in localStorage for demo
      const waitlist = JSON.parse(localStorage.getItem('secureagent_waitlist') || '[]');
      waitlist.push({ email, timestamp: new Date().toISOString() });
      localStorage.setItem('secureagent_waitlist', JSON.stringify(waitlist));

      // Show success
      form.reset();
      successMessage?.classList.remove('hidden');
      errorMessage?.classList.add('hidden');

    } catch (error) {
      // Show error
      errorMessage?.classList.remove('hidden');
      successMessage?.classList.add('hidden');

    } finally {
      // Reset button
      if (btnText) btnText.textContent = 'Join Waitlist';
      btnSpinner?.classList.add('hidden');
    }
  });
</script>

<style>
  .bg-gradient-radial {
    background: radial-gradient(circle, var(--tw-gradient-from), var(--tw-gradient-to));
  }
</style>
