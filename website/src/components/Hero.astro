---
// Hero component for the landing page
---

<header class="relative overflow-hidden">
  <!-- Navigation -->
  <nav class="relative z-10 flex items-center justify-between px-6 py-4 lg:px-8 max-w-7xl mx-auto">
    <div class="flex items-center gap-2">
      <img src="/favicon.svg" alt="SecureAgent Logo" class="w-8 h-8" />
      <span class="text-xl font-bold gradient-text">SecureAgent</span>
    </div>
    <div class="hidden md:flex items-center gap-6">
      <a href="https://github.com/ishanray/secureagent#readme" class="text-dark-300 hover:text-white transition-colors">
        Docs
      </a>
      <a href="https://github.com/ishanray/secureagent" class="text-dark-300 hover:text-white transition-colors flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        GitHub
      </a>
      <a href="#pricing" class="text-dark-300 hover:text-white transition-colors">
        Pricing
      </a>
    </div>
    <!-- Mobile menu button -->
    <button class="md:hidden text-dark-300 hover:text-white" aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Hero content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-24 lg:pt-24 lg:pb-32">
    <div class="text-center max-w-4xl mx-auto">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-dark-800/50 border border-dark-700 text-sm mb-8 animate-fade-in">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"></span>
        </span>
        <span class="text-dark-300">Now supporting MCP, LangChain & RAG systems</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-balance mb-6 animate-slide-up">
        Secure Your AI Agents
        <span class="gradient-text block mt-2">Before They're Exploited</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-dark-300 max-w-2xl mx-auto mb-10 animate-slide-up animate-delay-100">
        The open-source security scanner for MCP servers, LangChain, and AI agent frameworks.
        Find vulnerabilities before attackers do.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12 animate-slide-up animate-delay-200">
        <!-- Install command with copy -->
        <div class="relative group">
          <div class="flex items-center gap-2 px-5 py-3 bg-dark-800 border border-dark-600 rounded-lg font-mono text-sm group-hover:border-primary-500/50 transition-colors cursor-pointer" onclick="copyCommand()">
            <span class="text-dark-400">$</span>
            <span class="text-primary-400" id="install-command">pip install secureagent</span>
            <button class="ml-2 text-dark-400 hover:text-white transition-colors" aria-label="Copy to clipboard">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </button>
          </div>
          <span id="copy-tooltip" class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 bg-dark-700 text-xs rounded opacity-0 transition-opacity pointer-events-none">
            Copied!
          </span>
        </div>

        <a href="https://github.com/ishanray/secureagent" class="btn-secondary">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          View on GitHub
        </a>
      </div>

      <!-- Stats -->
      <div class="flex items-center justify-center gap-8 text-sm text-dark-400 animate-slide-up animate-delay-300">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>100% Open Source</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Fast Scans</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Privacy First</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Background gradient -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-gradient-radial from-primary-500/20 via-accent-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-gradient-radial from-accent-500/10 to-transparent rounded-full blur-3xl"></div>
  </div>
</header>

<script>
  function copyCommand() {
    const command = document.getElementById('install-command')?.textContent || '';
    navigator.clipboard.writeText(command).then(() => {
      const tooltip = document.getElementById('copy-tooltip');
      if (tooltip) {
        tooltip.style.opacity = '1';
        setTimeout(() => {
          tooltip.style.opacity = '0';
        }, 2000);
      }
    });
  }

  // Make function available globally
  (window as any).copyCommand = copyCommand;
</script>

<style>
  .bg-gradient-radial {
    background: radial-gradient(circle, var(--tw-gradient-from), var(--tw-gradient-via), var(--tw-gradient-to));
  }
</style>
